<mxfile host="app.diagrams.net"><diagram name="CampusCare System Architecture" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c12" value="Data tier — local files (instance/)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1420" height="130" as="geometry"/></mxCell><mxCell id="c6" value="Application tier — one Flask process (Python 3)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1420" height="440" as="geometry"/></mxCell><mxCell id="c2" value="Client tier — any modern browser" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1420" height="120" as="geometry"/></mxCell><mxCell id="c3" value="HTML5 templates (Jinja2)&lt;br&gt;Bootstrap 5 · responsive layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="300" height="60" as="geometry"/></mxCell><mxCell id="c4" value="JavaScript (ES6): duplicate hint,&lt;br&gt;image pre-check, form UX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="300" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Chart.js dashboards&lt;br&gt;(fetch /admin/api/stats)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="300" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Route controllers (blueprints): auth · main (reporter) · staff · admin   —   thin: parse input, call a service, render a template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="245" width="1340" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Cross-cutting security&lt;br&gt;Flask-Login sessions · role_required (RBAC)&lt;br&gt;CSRF token · security headers (CSP, nosniff)&lt;br&gt;login lock-out · Werkzeug password hashing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="400" height="120" as="geometry"/></mxCell><mxCell id="c9" value="Service layer (services.py)&lt;br&gt;workflow state machine &amp; permissions&lt;br&gt;duplicate detection · priority escalation&lt;br&gt;staff suggestion · statistics &amp; reports · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="340" width="440" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Upload handling&lt;br&gt;extension + size + magic-byte check&lt;br&gt;random file names · access-controlled&lt;br&gt;route (not public static files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="420" height="120" as="geometry"/></mxCell><mxCell id="c11" value="Data access: Flask-SQLAlchemy models — User · MaintenanceRequest · RequestAssignment · RequestUpdate · Feedback · AuditLog&lt;br&gt;(CHECK constraints and indexes declared in the model layer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="1340" height="100" as="geometry"/></mxCell><mxCell id="c13" value="SQLite database  campuscare.db&lt;br&gt;(swap by DATABASE_URL for PostgreSQL / MySQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="560" height="70" as="geometry"/></mxCell><mxCell id="c14" value="uploads/  — validated images, UUID names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="560" height="70" as="geometry"/></mxCell><mxCell id="c15" value="HTTP/HTML" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="JSON" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="SQL" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="write / read" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCe