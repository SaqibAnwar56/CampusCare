<mxfile host="app.diagrams.net"><diagram name="CampusCare ER Diagram" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;p style=&quot;margin:0;text-align:center;background:#dbeafe&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;PK id             INTEGER&lt;br&gt;   full_name      VARCHAR(100) NN&lt;br&gt;UQ email          VARCHAR(120) NN&lt;br&gt;   password_hash  VARCHAR(255) NN&lt;br&gt;   role           VARCHAR(20)  NN CHECK&lt;br&gt;   department     VARCHAR(100)&lt;br&gt;   specialty      VARCHAR(50)&lt;br&gt;   is_active_account BOOLEAN NN&lt;br&gt;   failed_attempts INTEGER NN&lt;br&gt;   locked_until   DATETIME&lt;br&gt;   created_at     DATETIME NN&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="360" height="206" as="geometry"/></mxCell><mxCell id="c3" value="&lt;p style=&quot;margin:0;text-align:center;background:#dbeafe&quot;&gt;&lt;b&gt;maintenance_requests&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;PK id               INTEGER&lt;br&gt;UQ reference_id      VARCHAR(20) NN&lt;br&gt;   title, description TEXT NN&lt;br&gt;IX category           VARCHAR(40) NN&lt;br&gt;   building, location VARCHAR NN&lt;br&gt;   requested_priority VARCHAR(10) NN&lt;br&gt;   priority           VARCHAR(10) NN CHECK&lt;br&gt;   status             VARCHAR(20) NN CHECK&lt;br&gt;   image_filename     VARCHAR(100)&lt;br&gt;   resolution_notes   TEXT&lt;br&gt;FK requester_id       → users.id NN&lt;br&gt;FK duplicate_of_id    → requests.id&lt;br&gt;   created_at, updated_at, due_at NN&lt;br&gt;   resolved_at, closed_at DATETIME&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="380" height="253" as="geometry"/></mxCell><mxCell id="c4" value="&lt;p style=&quot;margin:0;text-align:center;background:#dbeafe&quot;&gt;&lt;b&gt;request_assignments&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;PK id            INTEGER&lt;br&gt;FK request_id    → requests.id NN&lt;br&gt;FK staff_id      → users.id NN&lt;br&gt;FK assigned_by_id→ users.id NN&lt;br&gt;   assigned_at   DATETIME NN&lt;br&gt;   is_active     BOOLEAN NN&lt;br&gt;   note          VARCHAR(255)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="1240" y="40" width="380" height="144" as="geometry"/></mxCell><mxCell id="c5" value="&lt;p style=&quot;margin:0;text-align:center;background:#dbeafe&quot;&gt;&lt;b&gt;request_updates&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;PK id          INTEGER&lt;br&gt;FK request_id  → requests.id NN&lt;br&gt;FK author_id   → users.id NN&lt;br&gt;   event_type  VARCHAR(20) NN&lt;br&gt;   from_status VARCHAR(20)&lt;br&gt;   to_status   VARCHAR(20)&lt;br&gt;   note        TEXT&lt;br&gt;   created_at  DATETIME NN&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="380" height="160" as="geometry"/></mxCell><mxCell id="c6" value="&lt;p style=&quot;margin:0;text-align:center;background:#dbeafe&quot;&gt;&lt;b&gt;feedback&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;PK id          INTEGER&lt;br&gt;FK,UQ request_id → requests.id NN&lt;br&gt;FK user_id     → users.id NN&lt;br&gt;   rating      INTEGER NN CHECK 1..5&lt;br&gt;   comment     VARCHAR(500)&lt;br&gt;   created_at  DATETIME NN&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="1240" y="640" width="380" height="129" as="geometry"/></mxCell><mxCell id="c7" value="&lt;p style=&quot;margin:0;text-align:center;background:#dbeafe&quot;&gt;&lt;b&gt;audit_logs&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;PK id           INTEGER&lt;br&gt;FK user_id      → users.id (NULL ok)&lt;br&gt;IX action        VARCHAR(40) NN&lt;br&gt;IX entity_type, entity_id VARCHAR&lt;br&gt;   details       TEXT&lt;br&gt;   ip_address    VARCHAR(45)&lt;br&gt;IX created_at    DATETIME NN&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="380" height="144" as="geometry"/></mxCell><mxCell id="c14" value="Normalisation (3NF): reporter, staff and administrator details live only in&lt;br&gt;users; assignments, status history and feedback are separate tables so&lt;br&gt;re-assignment and re-opening never overwrite earlier facts. Current&lt;br&gt;assignee = the single row with is_active = TRUE for the request." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;size=14;" vertex="1" parent="1"><mxGeometry x="640" y="700" width="460" height="120" as="geometry"/></mxCell><mxCell id="c8" value="reports" style="html=1;endArrow=none;strokeColor=#0b1