ent="1"><mxGeometry x="1005" y="45" width="360" height="108" as="geometry"/></mxCell><mxCell id="c9" value="&lt;p style=&quot;margin:0;text-align:center;background:#e8f0fe&quot;&gt;&lt;i style=&quot;font-size:10px;color:#64748b&quot;&gt;«decorator / hooks»&lt;/i&gt;&lt;br&gt;&lt;b&gt;RBAC / Security&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;role_required(*roles)&lt;br&gt;csrf_protect()&lt;br&gt;security headers&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="1420" y="45" width="310" height="92" as="geometry"/></mxCell><mxCell id="c10" value="&lt;p style=&quot;margin:0;text-align:center;background:#e8f0fe&quot;&gt;&lt;i style=&quot;font-size:10px;color:#64748b&quot;&gt;«service»&lt;/i&gt;&lt;br&gt;&lt;b&gt;RequestService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;create_request(user, form, file)&lt;br&gt;transition(req, actor, to, note)&lt;br&gt;assign(req, admin, staff_id, note)&lt;br&gt;change_priority(req, admin, p, why)&lt;br&gt;submit_feedback(req, user, rating)&lt;br&gt;find_duplicates()  escalate_priority()&lt;br&gt;audit(user, action, entity, id)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0b1f3a;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="380" height="154" as="geometry"/></mxCell><mxCell id="c11" value="&lt;p style=&quot;margin:0;text-align:center;background:#e8f0fe&quot;&gt;&lt;i style=&quot;font-size:10px;color:#64748b&quot;&gt;«policy»&lt;/i&gt;&lt;br&gt;&lt;b&gt;WorkflowPolicy&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px;font-family:Courier New;font-size:11px&quot;&gt;TRANSITIONS: {(from,to):