<mxfile host="app.diagrams.net"><diagram name="Request workflow (state machine)" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Submitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="170" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Under Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="170" height="62" as="geometry"/></mxCell><mxCell id="c4" value="Assigned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="170" height="62" as="geometry"/></mxCell><mxCell id="c5" value="In Progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="200" width="170" height="62" as="geometry"/></mxCell><mxCell id="c6" value="Resolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="200" width="170" height="62" as="geometry"/></mxCell><mxCell id="c7" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cbd5e1;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="200" width="170" height="62" as="geometry"/></mxCell><mxCell id="c8" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#0b1f3a;fontColor=#0b1f3a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="170" height="62" as="geometry"/></mxCell><mxCell id="c9" value="Roles in [brackets]: A = Administrator, S = assigned Staff, R = reporting Student/Faculty" style="text;html=1;align=left;verticalAlign=middle;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="400" height="20" as="geometry"/></mxCell><mxCell id="c20" value="Rules enforced in services.transition():&lt;br&gt;• only the listed (from → to) pairs exist; anything else raises WorkflowError&lt;br&gt;• the role AND ownership must match (S = the currently assigned staff member)&lt;br&gt;• “Assigned” is reachable only through assign(), so an assignee is always recorded&lt;br&gt;• Rejected and Closed are terminal; every change writes history + audit rows" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;size=14;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="720" height="150" as="geometry"/></mxCell><mxCell id="c10" value="[A] start review" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="[A] assign()" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="[S] start work" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="[S] resolve + notes" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="[R/A] confirm &amp; close" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="[A] reject + reason" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c2" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="500"/></Array></mxGeometry></mxCell><mxCell id="c16" value="[A] reject + reason" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="[A] pull back" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="130"/><mxPoint x="415" y="130"/></Array></mxGeometry></mxCell><mxCell id="c18" value="[A] pull back" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="90"/><mxPoint x="415" y="90"/></Array></mxGeometry></mxCell><mxCell id="c19" value="[R/A] re-open + reason" style="html=1;endArrow=block;endFill=1;strokeColor=#0b1f3a;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="330"/><mxPoint x="955" y="330"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>